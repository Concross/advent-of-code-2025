# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out

# Go workspace file (go.work.sum is generated)
go.work.sum

# Dependency directories
vendor/

# IDE specific files
.vscode/
.idea/
*.swp
*.swo
*~

# OS specific files
.DS_Store
Thumbs.db

# Day-specific binaries (dayXX executables)
day[0-9][0-9]
!/day[0-9][0-9]/

# Puzzle inputs are personal, but we'll keep the template
# If you want to exclude actual inputs, uncomment the next line:
# day*/input.txt
